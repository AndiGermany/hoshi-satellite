# =============================================================================
# secrets.yaml.example — Vorlage für secrets.yaml (NICHT die echte Datei!)
# =============================================================================
#
# So benutzen: diese Datei nach `secrets.yaml` kopieren (gleicher Ordner, neben
# hoshi-voice-pe.yaml) und die Platzhalter durch echte Werte ersetzen.
#
#   cp secrets.yaml.example secrets.yaml
#
# secrets.yaml ist per .gitignore (siehe firmware/esphome/.gitignore) von git
# ausgeschlossen — NIEMALS committen, egal wie "test" die Werte aussehen.
# Diese .example-Datei ist der einzige Teil davon, der im Repo landet.
# =============================================================================

# --- WLAN-Zugangsdaten. 2.4 GHz ONLY (kein 5 GHz) — siehe firmware/README. ---
wifi_ssid: "<dein-2.4ghz-wlan-name>"
wifi_password: "<dein-wlan-passwort>"

# --- OTA-Passwort (ota: platform: esphome, password: !secret ota_password). ---
# Schützt drahtlose Firmware-Updates vor jedem im selben LAN. Frei wählbar,
# lange zufällige Zeichenkette empfohlen (z.B. `openssl rand -hex 16`).
ota_password: "<beliebiges-langes-ota-passwort>"

# --- Hoshi-Backend-Token (hoshi_ws_audio: auth_token: !secret hoshi_api_token). ---
# Der API-Token deines Hoshi-Backends (contract §A). Ohne gültigen Token lehnt
# der WS-Handshake mit Close 1008 ab — kein Ton, keine Fehlermeldung am Gerät.
hoshi_api_token: "<dein-hoshi-api-token>"

# --- Optionaler TLS-Leaf-Override (hoshi_ws_audio: cacert_pem: !secret hoshi_leaf_pem). ---
# NUR nötig, wenn dein Hoshi-Backend NICHT den in der Component eingebetteten
# Standard-Leaf verwendet (siehe hoshi-voice-pe.yaml Kommentar bei cacert_pem).
# Leer lassen ("") um den eingebetteten Default zu benutzen — das ist der
# Normalfall für ein frisches Setup gegen dasselbe Backend-Zertifikat.
hoshi_leaf_pem: ""
