# =============================================================================
# secrets.yaml.example — Vorlage für secrets.yaml (NICHT die echte Datei!)
# =============================================================================
#
# So benutzen: diese Datei nach `secrets.yaml` kopieren (gleicher Ordner, neben
# hoshi-voice-pe.yaml) und die leeren Werte füllen:
#
#   cd <Ordner dieser Datei> && cp secrets.yaml.example secrets.yaml
#
# secrets.yaml ist per .gitignore (gleicher Ordner) von git ausgeschlossen —
# NIEMALS committen, egal wie „test" die Werte aussehen. Diese .example-Datei
# ist der einzige Teil davon, der im Repo landet. `bin/hoshi satellite flash`
# prüft im Vorflug nur, DASS die Schlüssel da sind — nie, was drinsteht.
# =============================================================================

# --- WLAN. 2.4 GHz ONLY (kein 5 GHz) — der ESP32-S3 kann kein 5-GHz-Band. ---
wifi_ssid: ""
wifi_password: ""

# --- OTA-Passwort (ota: platform: esphome). Schützt drahtlose Updates vor
# jedem im selben LAN. Frei wählbar, lang und zufällig (`openssl rand -hex 16`).
ota_password: ""

# --- Hoshi-Backend-Token (hoshi_ws_audio: auth_token). 0.8 liest den Token NUR
# aus dem ?token=-Query beim WS-Upgrade; ohne gültigen Token schließt der Server
# mit 1008 — stumm am Gerät. Quelle: ~/.hoshi/secrets.json["api"] auf dem Mac.
hoshi_api_token: ""

# --- CA-Pin (hoshi_ws_audio: cacert_pem). Das ist der Vertrauensanker des
# Satelliten: der ÖFFENTLICHE Teil der Hoshi Home CA aus ~/.hoshi/ca/hoshi-ca.crt
# (`bin/hoshi cert export-profile` legt sie zusätzlich nach ~/.hoshi/ca/export).
# Als YAML-Blockskalar einsetzen, Inhalt der .crt-Datei um zwei Leerzeichen
# eingerückt — der private CA-Schlüssel bleibt auf dem Mac und kommt NIE hierher:
#
#   hoshi_ca_pem: |
#     <der GANZE Inhalt von ~/.hoshi/ca/hoshi-ca.crt, jede Zeile um zwei
#      Leerzeichen eingerückt — inklusive der BEGIN-/END-Zeilen>
#
# Weil der Anker die CA ist und nicht das Server-Blatt, überlebt der Satellit
# jede Blatt-Erneuerung ohne Flash (Vertrag §A, seit 05.09.2026).
hoshi_ca_pem: ""

# --- Optionaler TLS-Blatt-Override. Nur nötig, wenn das Backend NICHT von der
# Hoshi-CA signiert ist (Übergang/Fremdserver). Leer lassen = Normalfall.
hoshi_leaf_pem: ""
