# =============================================================================
# secrets.yaml.example — copy to secrets.yaml and fill in your own values.
# secrets.yaml is gitignored — NEVER commit real credentials.
# =============================================================================
#
# WiFi: 2.4 GHz ONLY (no 5 GHz) — see ../../RUNBOOK.md Phase 2.
wifi_ssid: "<your-2.4ghz-wifi-ssid>"
wifi_password: "<your-wifi-password>"

# OTA update password (optional but recommended once you go wireless).
ota_password: "<pick-a-strong-ota-password>"

# API token your Hoshi backend expects on the /ws/audio WebSocket upgrade
# (query param ?token=... — see docs/PROTOCOL.md §A for the exact contract).
# Treat this like any other bearer credential.
hoshi_api_token: "<your-hoshi-api-token>"

# Optional: override the embedded TLS leaf certificate at runtime instead of
# recompiling. Leave empty to use the (placeholder, must-be-replaced) default
# baked into components/hoshi_ws_audio/hoshi_ws_audio.cpp.
hoshi_leaf_pem: ""
